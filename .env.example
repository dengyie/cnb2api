# ---- proxy (required) ----
# Bearer key your clients send. No default: the proxy refuses to start without it.
PROXY_KEY=change-me-to-a-long-random-string

# ---- upstream (required in production) ----
# Injected automatically by the CNB pipeline stage; only needed for standalone runs.
CNB_TOKEN=change-me

# org/repo the AI endpoint belongs to. Inside a CNB workspace CNB_BUILD_REPO
# already holds this; set CNB_REPO_SLUG only for local/standalone runs.
# The quota CLI also derives the org to query from this value.
CNB_REPO_SLUG=your-org/ai-proxy

# ---- quota CLI (npm run quota / cnb2api-quota) ----
# Same CNB_TOKEN as above; it must be allowed to read the org's charge quota.
# Works with any token that can see the org — it does not need pipeline scopes.
# Override the target org without touching CNB_REPO_SLUG:
#QUOTA_ORG=your-org

# ---- optional tuning ----
# Fallback model ids for /v1/models, used only until a response reveals the
# real upstream model name (which is then cached). See src/models.mjs.
#PROXY_MODELS=deepseek-v4.1-flash,glm-5.3-flash,kimi-k3
# Where the sniffed-model registry is persisted across workspace restarts.
#PROXY_MODELS_STATE=models-state.json
#PROXY_PORT=9001
# Upstream connect/first-byte timeout (ms)
#PROXY_UPSTREAM_TIMEOUT_MS=15000
# Per-stream idle watchdog (ms)
#PROXY_IDLE_TIMEOUT_MS=300000

# ---- thinking (optional, off by default) ----
# Forward the client's thinking toggles (reasoning_effort / reasoning /
# enable_thinking / thinking, and Anthropic thinking:{type:enabled}) to the
# upstream thinking variant instead of stripping them.
#
# Why this is off by default: the thinking variant bills its reasoning phase
# against max_tokens. With a small budget the reasoning consumes everything and
# the answer is never generated (finish_reason=length, empty content).
#
# Turn it on only if your clients send a large max_tokens (>= 32k is a safe
# starting point; 60k was verified). Requests that carry no thinking toggle are
# unaffected either way.
#CNB2API_ALLOW_THINKING=1

# ---- self-registration to the fixed-domain relay (optional) ----
# Full URL of the relay endpoint, e.g. https://ai.example.com/ops/register
#REGISTER_URL=
# Shared secret expected by the relay's cnb-register.py (X-Reg-Token header).
#REG_TOKEN=

# ---- test-only ----
# Point the upstream at a local mock server instead of CNB.
#UPSTREAM_OVERRIDE=http://127.0.0.1:8080
