# ---- proxy (required) ----
# Bearer key your clients send. No default: the proxy refuses to start without it.
PROXY_KEY=change-me-to-a-long-random-string

# ---- upstream (required in production) ----
# Injected automatically by the CNB pipeline stage; only needed for standalone runs.
CNB_TOKEN=change-me

# org/repo the AI endpoint belongs to. Inside a CNB workspace CNB_BUILD_REPO
# already holds this; set CNB_REPO_SLUG only for local/standalone runs.
# The quota CLI also derives the org to query from this value.
CNB_REPO_SLUG=your-org/ai-proxy

# ---- quota CLI (npm run quota / cnb2api-quota) ----
# Same CNB_TOKEN as above; it must be allowed to read the org's charge quota.
# Works with any token that can see the org — it does not need pipeline scopes.
# Override the target org without touching CNB_REPO_SLUG:
#QUOTA_ORG=your-org

# ---- optional tuning ----
# Fallback model ids for /v1/models, used only until a response reveals the
# real upstream model name (which is then cached). See src/models.mjs.
#PROXY_MODELS=deepseek-v4.1-flash,glm-5.3-flash,kimi-k3
# Where the sniffed-model registry is persisted across workspace restarts.
#PROXY_MODELS_STATE=models-state.json
#PROXY_PORT=9001
# Upstream connect/first-byte timeout (ms)
#PROXY_UPSTREAM_TIMEOUT_MS=15000
# Per-stream idle watchdog (ms)
#PROXY_IDLE_TIMEOUT_MS=300000

# ---- outbound neutralization (code 11128 workaround) ----
# The upstream AI gateway runs client-fingerprint moderation on the prompt: a
# request that carries a known client fingerprint and is large enough (>~1 KB)
# is rejected with HTTP 400 / code 11128 "Illegal API invocation from an
# unapproved channel". Measured behaviour (2026-10): only system/assistant text
# is scanned (user text and tool schemas are not), and the match is fuzzy — two
# innocuous-looking sentences can trip it together. Tokens, accounts and model
# names make no difference.
# On by default: known fingerprint phrases are rewritten to equivalent forms
# (zero-width space; file-path occurrences skipped) before the request leaves the
# workspace. Set to 0 to send requests byte-for-byte.
#PROXY_NEUTRALIZE=1
# Also break the bare brand word itself (rarely needed; off keeps prose intact).
#PROXY_NEUTRALIZE_AGGRESSIVE=0
# Fallback ladder: when the upstream still answers 400/11128, re-send the same
# content twice more with a shape the scanner does not inspect — first with the
# system text folded into the first user turn (no extra tokens), then with
# system/assistant text word-obfuscated (covers fingerprints in chat history).
# Rejected requests generate nothing, so retries cost no credits.
#PROXY_BLOCK_RETRY=1
# Map developer -> system and hoist a system message that appears later.
#PROXY_ENSURE_SYSTEM=1
# Prepend a neutral system message when the request has none (off: it would
# change prompt semantics; enable only if your upstream hard-requires it).
#PROXY_SYNTHETIC_SYSTEM=0

# ---- self-registration to the fixed-domain relay (optional) ----
# Full URL of the relay endpoint, e.g. https://ai.example.com/ops/register
#REGISTER_URL=
# Shared secret expected by the relay's cnb-register.py (X-Reg-Token header).
#REG_TOKEN=

# ---- test-only ----
# Point the upstream at a local mock server instead of CNB.
#UPSTREAM_OVERRIDE=http://127.0.0.1:8080
